# ============================================================
# CODE COMPARATOR - MANIFEST.in
# File da includere nel pacchetto di distribuzione
# ============================================================

# ============================================================
# DOCUMENTAZIONE
# ============================================================
include README.md
include LICENSE
include CHANGELOG.md

# ============================================================
# CONFIGURAZIONE
# ============================================================
include requirements.txt
include setup.py
include .gitignore

# ============================================================
# PRESET PREDEFINITI
# ============================================================
# Include preset.json se vuoi fornire preset predefiniti agli utenti
include presets.json

# ============================================================
# ESEMPI (se li crei)
# ============================================================
# Ricorsivo: include tutto nella cartella examples/
recursive-include examples *.xlsx
recursive-include examples *.xls
recursive-include examples *.md

# ============================================================
# DOCUMENTAZIONE EXTRA (se la crei)
# ============================================================
recursive-include docs *.md
recursive-include docs *.png
recursive-include docs *.jpg
recursive-include docs *.pdf

# ============================================================
# ASSETS/ICONE (se ne aggiungi in futuro)
# ============================================================
# recursive-include assets *.png
# recursive-include assets *.ico
# recursive-include assets *.svg

# ============================================================
# ESCLUSIONI GLOBALI
# ============================================================
# Escludi file temporanei
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude *~
global-exclude *.swp

# Escludi file di sistema
global-exclude .DS_Store
global-exclude Thumbs.db

# Escludi file Excel temporanei
global-exclude ~$*.xlsx
global-exclude ~$*.xls

# Escludi file di backup
global-exclude *.bak
global-exclude *.backup
global-exclude *.old

# Escludi output generati dall'app
global-exclude *_Corrispondenze*.xlsx
global-exclude *_Mancanti*.xlsx

# Escludi log
global-exclude *.log

# Escludi configurazioni Git
global-exclude .git*
global-exclude .github

# Escludi ambienti virtuali
global-exclude venv
global-exclude env
global-exclude .venv

# Escludi build artifacts
global-exclude dist
global-exclude build
global-exclude *.egg-info
